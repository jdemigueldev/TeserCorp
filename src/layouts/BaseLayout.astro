---
interface Props {
	title: string;
	description: string;
	ogTitle?: string;
	ogDescription?: string;
	ogImage?: string;
}

const { title, description, ogTitle, ogDescription, ogImage } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={ogTitle || title} />
		<meta property="og:description" content={ogDescription || description} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content={ogImage || "https://dummyimage.com/1200x630/111315/ffffff&text=TeserCorp"} />
		<link rel="icon" type="image/jpg" href="/iconotela.png" />

		<!-- Tailwind CSS CDN -->
		<script src="https://cdn.tailwindcss.com"></script>
		<script is:inline>
			// Tailwind config: custom industrial palette
			tailwind.config = {
				theme: {
					extend: {
						fontFamily: {
							display: ['"Rajdhani"', "ui-sans-serif", "system-ui", "Segoe UI"],
							mono: ['"JetBrains Mono"', "ui-monospace", "SFMono-Regular"],
						},
						colors: {
							steel: {
								900: "#0f1113",
								800: "#161a1d",
								700: "#1d2328",
								600: "#2a3036",
								500: "#39424a",
							},
							hazard: "#38c1de",
							oxide: "#B4462A",
							signal: "#2C6CFF",
							zincish: "#A9B0B7",
						},
						boxShadow: {
							pane: "0 10px 30px rgba(0,0,0,0.35)",
						},
						backgroundImage: {
							grid: "linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px)",
							plate: "radial-gradient(1200px 600px at 10% -20%, rgba(242,194,0,0.10), transparent 60%), radial-gradient(1200px 600px at 90% 120%, rgba(44,108,255,0.08), transparent 60%)",
						},
					},
				},
			};
		</script>
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;800&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet" />
		<style>
			/* Subtle noise for industrial texture */
			body::before {
				content: "";
				position: fixed;
				inset: 0;
				pointer-events: none;
				z-index: 0;
				background-image: url('data:image/svg+xml;utf8,<svg xmlns="https://www.w3.org/2000/svg" width="140" height="140" viewBox="0 0 140 140"><filter id="n"><feTurbulence baseFrequency="0.9" numOctaves="2" seed="3" type="fractalNoise"/><feColorMatrix type="saturate" values="0"/><feComponentTransfer><feFuncA type="linear" slope="0.03"/></feComponentTransfer></filter><rect width="100%" height="100%" filter="url(%23n)"/></svg>');
				mix-blend-mode: soft-light;
			}
			/* Divider stripes */
			.stripe {
				background: repeating-linear-gradient(45deg, rgba(56, 193, 222, 0.7) 0 12px, transparent 12px 24px);
				mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
			}
			/* Focus ring */
			:focus {
				outline: none;
			}
			:focus-visible {
				box-shadow: 0 0 0 3px #8805a855, 0 0 0 6px #2c6cff33;
				border-radius: 0.4rem;
			}
		</style>
	</head>
	<body class="bg-steel-900 text-zinc-200 bg-plate">
		<slot />
	</body>
</html>
